   "source": [
    "CREATE OR REPLACE MATERIALIZED VIEW dbacademy.silver.SALES_SUMMARY AS\n",
    "    SELECT COUNTRY, COUNT(*) AS TOTAL_TRANSACTIONS\n",
    "    FROM dbacademy.bronze.sales_customers CUST\n",
    "    INNER JOIN dbacademy.bronze.sales_transactions TRANS ON CUST.customerID = TRANS.customerID\n",
    "    GROUP BY COUNTRY"
   ]
  }
 ],
